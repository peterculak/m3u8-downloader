# Download YouTube video as m4a audio only (pass --share to send via WhatsApp)
yt-audio url *args="":
    #!/usr/bin/env bash
    SHARE=false
    FILENAME=""
    for arg in {{args}}; do
        if [ "$arg" = "--share" ] || [ "$arg" = "-s" ]; then
            SHARE=true
        else
            FILENAME="$arg"
        fi
    done

    if [ -z "$FILENAME" ]; then
        if [ "$SHARE" = "true" ]; then
            yt-dlp --replace-in-metadata title "[^\w\s-]" "" --replace-in-metadata title "[\s_]+" "-" --replace-in-metadata title "^[-_.]+" "" -f "bestaudio[ext=m4a]" -o "downloads/youtube/%(title)s.%(ext)s" --exec "node share.js {}" "{{url}}"
        else
            yt-dlp --replace-in-metadata title "[^\w\s-]" "" --replace-in-metadata title "[\s_]+" "-" --replace-in-metadata title "^[-_.]+" "" -f "bestaudio[ext=m4a]" -o "downloads/youtube/%(title)s.%(ext)s" "{{url}}"
        fi
    else
        if [ "$SHARE" = "true" ]; then
            yt-dlp -f "bestaudio[ext=m4a]" -o "downloads/youtube/$FILENAME.%(ext)s" --exec "node share.js {}" "{{url}}"
        else
            yt-dlp -f "bestaudio[ext=m4a]" -o "downloads/youtube/$FILENAME.%(ext)s" "{{url}}"
        fi
    fi

# Download any m3u8 stream as an m4a audio file
m3u8-audio url filename="audio":
    ffmpeg -y -loglevel verbose -headers $'Referer: https://www.ta3.com/\r\n' -i "{{url}}" -vn -c:a aac -b:a 256k "{{filename}}.m4a"

# Clean all downloaded m4a audio files
clean:
    find downloads -type f -name "*.m4a" -delete

# Clean files and reset download history
clear: clean
    echo "[]" > download_history.json

# Run the automated daily show downloader
run-downloader:
    node downloader.js

# Download daily shows from ta3 (supports --days N, --all, --share, etc.)
ta3 *args="":
    node downloader.js {{args}}

# Download a podcast episode from a tyzden.sk article URL
# Usage: just tyzden <url>
tyzden url:
    node tyzden.js "{{url}}"

